# Production is the default. Set this to true only for local demo data.
VITE_USE_MOCK_DATA=false

# REST API base URL. The frontend calls /nodes, /alerts, /gateways, etc. below this path.
VITE_API_BASE_URL=/api

# Optional absolute WebSocket URL. If omitted, the frontend derives /ws/telemetry
# from VITE_API_BASE_URL or the current browser host.
VITE_TELEMETRY_WS_URL=
